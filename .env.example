# ============================================================
# AdashiCircle — Environment Configuration Example
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AdashiCircle

# --- Super Admin Seed (used during first deploy) ---
SUPER_ADMIN_EMAIL=admin@adashicircle.com
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword123!

# --- Email (Resend - https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@adashicircle.com

# --- SMS (Africa's Talking - future phase) ---
# AFRICAS_TALKING_USERNAME=your-username
# AFRICAS_TALKING_API_KEY=your-api-key
# AFRICAS_TALKING_SENDER_ID=AdashiCircle

# --- Payment Gateway (Paystack - sandbox mode default) ---
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- File Storage ---
# Supabase Storage is used by default (configured via Supabase dashboard)
# Max upload size in bytes (default 5MB)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=5242880

# --- Security ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

